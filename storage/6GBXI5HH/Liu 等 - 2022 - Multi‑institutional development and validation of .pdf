            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Background: Early-onset gastric cancer (EOGC, &amp;le;45 years old) is characterized with increasing incidence and more malignant phenotypes compared with late-onset gastric cancer, which exhibits remarkable immune cell infiltration and is potential immunotherapeutic population.</rdf:li>
            </rdf:Alt>
         </dc:description>
