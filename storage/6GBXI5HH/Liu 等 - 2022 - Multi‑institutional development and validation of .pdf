         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Multiâ€‘institutional development and validation of a nomogram to predict prognosis of early-onset gastric cancer patients</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Hongda Liu</rdf:li>
